page {
  background-color: #F7F6F2;
  color: #2B2D42;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, scroll-view, input, textarea, button, image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 45, 66, 0.05);
  margin-bottom: 20rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2D42;
  margin-bottom: 16rpx;
}

.text-muted {
  color: #7F8596;
  font-size: 24rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.badge-primary {
  background-color: #FFF0E8;
  color: #FF6B35;
}

.badge-green {
  background-color: #E8F8F0;
  color: #22A06B;
}

.badge-warn {
  background-color: #FFF5E5;
  color: #E68A00;
}

.badge-danger {
  background-color: #FFECEB;
  color: #E5484D;
}

.badge-gray {
  background-color: #F0F1F5;
  color: #6B7280;
}

.btn-primary {
  background: linear-gradient(135deg, #FF7D4D, #FF5A1F);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 32rpx;
  text-align: center;
  line-height: 1.3;
}

.btn-secondary {
  background-color: #FFF0E8;
  color: #FF6B35;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  text-align: center;
  line-height: 1.3;
}

.btn-ghost {
  background-color: #F3F4F6;
  color: #4B5563;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 14rpx 26rpx;
  text-align: center;
  line-height: 1.3;
}

.empty-box {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #8E95A5;
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  display: block;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4B5563;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8E95A5;
}

/* 通用底部弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.5);
  z-index: 900;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-mask.center {
  align-items: center;
  padding: 32rpx;
}

.modal-sheet {
  width: 100%;
  background-color: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  max-height: 82vh;
  overflow-y: auto;
}

.modal-dialog {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  max-height: 82vh;
  overflow-y: auto;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  background-color: #F7F6F2;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #2B2D42;
  width: 100%;
  min-height: 76rpx;
}

.row-between > .form-input,
.row-center > .form-input {
  width: auto;
  min-width: 0;
}

.form-textarea {
  background-color: #F7F6F2;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #2B2D42;
  width: 100%;
  min-height: 160rpx;
}
