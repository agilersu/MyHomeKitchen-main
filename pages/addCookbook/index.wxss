.seg-tabs {
  background-color: #EAE7DF;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.seg-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 25rpx;
  font-weight: 600;
  color: #6B7280;
  border-radius: 999rpx;
}

.seg-tab.active {
  background-color: #FFFFFF;
  color: #2B2D42;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.demo-fill-btn {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.cover-picker {
  width: 164rpx;
  height: 164rpx;
  border-radius: 22rpx;
  background-color: #F7F6F2;
  border: 2rpx dashed #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.emoji-row {
  margin-top: 12rpx;
  gap: 10rpx;
  flex-wrap: wrap;
}

.emoji-opt {
  font-size: 32rpx;
  padding: 4rpx 8rpx;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
}

.emoji-opt.active {
  background-color: #FFF0E8;
  border: 2rpx solid #FF6B35;
}

.field-group {
  margin-bottom: 18rpx;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
}

.pick-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background-color: #F3F4F6;
  font-size: 24rpx;
  color: #4B5563;
}

.pick-chip.active {
  background-color: #FFF0E8;
  color: #FF6B35;
  font-weight: 700;
}

.diff-chip {
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background-color: #F3F4F6;
  font-size: 23rpx;
  color: #4B5563;
}

.diff-chip.active {
  background-color: #2B2D42;
  color: #FFFFFF;
  font-weight: 600;
}

.add-row-btn {
  font-size: 25rpx;
  color: #FF6B35;
  font-weight: 700;
}

.ing-edit-row {
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.ing-name-in {
  flex: 2;
  width: auto;
  min-width: 0;
}

.ing-amt-in {
  flex: 1;
  width: auto;
  min-width: 0;
}

.ing-unit-in {
  flex: 1;
  width: auto;
  min-width: 0;
}

.rm-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.step-edit-row {
  margin-bottom: 18rpx;
}

.step-idx {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B35;
}
