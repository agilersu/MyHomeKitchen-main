<view class="container">
  <!-- 顶部汇总操作 -->
  <view class="card hero">
    <view class="row-between">
      <view>
        <view class="hero-title">🛒 智能买菜清单</view>
        <view class="text-muted">已自动汇总待做订单与近2天饮食计划所需食材，并比对冰箱库存</view>
      </view>
    </view>
    <view class="hero-actions row-between" style="margin-top: 20rpx; gap: 16rpx;">
      <view class="btn-secondary flex-1" bindtap="copyListText">📋 复制清单发微信</view>
      <view class="btn-primary flex-1" bindtap="onStockChecked">🧊 已买一键入冰箱 ({{checkedCount}})</view>
    </view>
    <view wx:if="{{totalCount > 0}}" class="select-all-row row-between" bindtap="onToggleSelectAll">
      <view class="row-center">
        <view class="check-box {{allChecked ? 'checked' : ''}}">
          <text wx:if="{{allChecked}}">✓</text>
        </view>
        <text class="select-all-text">{{allChecked ? '取消全选' : '全选全部食材'}}</text>
      </view>
      <text class="text-muted">已选 {{checkedCount}}/{{totalCount}} 项</text>
    </view>
  </view>

  <!-- 手动添加采购项 -->
  <view class="card">
    <view class="row-between" style="gap: 12rpx;">
      <input class="form-input" style="flex: 2;" placeholder="临时想买啥（如：牛奶、大葱）" value="{{newItemName}}" bindinput="onNewNameInput" />
      <input class="form-input" style="flex: 1;" placeholder="数量(如2盒)" value="{{newItemAmt}}" bindinput="onNewAmtInput" />
      <view class="add-btn" bindtap="onAddCustomItem">+ 添加</view>
    </view>
  </view>

  <!-- 待做订单 & 计划自动汇总 -->
  <view class="card">
    <view class="row-between" style="margin-bottom: 14rpx;">
      <text class="section-title" style="margin-bottom: 0;">🥘 订单与计划自动汇总 ({{autoItems.length}})</text>
      <text class="text-muted">缺货优先排前</text>
    </view>
    <view wx:if="{{autoItems.length === 0}}" class="empty-box" style="padding: 40rpx 0;">
      <view class="empty-desc">暂无待做订单或饮食计划食材</view>
    </view>

    <view
      wx:for="{{autoItems}}"
      wx:key="key"
      class="shop-row row-between"
      data-key="{{item.key}}"
      data-custom="0"
      bindtap="onToggleItem"
    >
      <view class="row-center flex-1">
        <view class="check-box {{item.checked ? 'checked' : ''}}">
          <text wx:if="{{item.checked}}">✓</text>
        </view>
        <view class="flex-1">
          <view class="shop-name {{item.checked ? 'done' : ''}}">{{item.name}} · {{item.amountText}}</view>
          <view class="text-muted">用于：{{item.sourcesText}}</view>
        </view>
      </view>
      <text class="badge {{item.inFridge ? 'badge-green' : 'badge-warn'}}">{{item.fridgeStockText}}</text>
    </view>
  </view>

  <!-- 手动临时采购项 -->
  <view class="card" wx:if="{{customItems.length > 0}}">
    <view class="section-title">📝 手动待买项 ({{customItems.length}})</view>
    <view
      wx:for="{{customItems}}"
      wx:key="id"
      class="shop-row row-between"
      data-key="{{item.id}}"
      data-custom="1"
      bindtap="onToggleItem"
    >
      <view class="row-center flex-1">
        <view class="check-box {{item.checked ? 'checked' : ''}}">
          <text wx:if="{{item.checked}}">✓</text>
        </view>
        <view class="shop-name {{item.checked ? 'done' : ''}}">{{item.name}} · {{item.amountText}}</view>
      </view>
      <text class="del-btn" data-id="{{item.id}}" catchtap="onRemoveCustom">删除</text>
    </view>
  </view>
</view>
