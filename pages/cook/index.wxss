.hero-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F5 100%);
}

.hero-card .btn-secondary {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.action-pair {
  margin-top: 22rpx;
  gap: 18rpx;
}

.pair-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  gap: 10rpx;
}

.pair-icon {
  width: 32rpx;
  height: 32rpx;
}

.seg-tabs {
  background-color: #EAE7DF;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.seg-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  border-radius: 999rpx;
}

.seg-tab.active {
  background-color: #FFFFFF;
  color: #2B2D42;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.order-head {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.order-head .badge {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.meal-chip {
  font-size: 28rpx;
  font-weight: 700;
  color: #2B2D42;
}

.kitchen-tag {
  font-size: 20rpx;
  background-color: #F3F4F6;
  color: #6B7280;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.orderer-row {
  margin-top: 12rpx;
}

.remark-box {
  margin-top: 12rpx;
  background-color: #FFF8EB;
  color: #9A5B13;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.dish-list {
  margin-top: 16rpx;
}

.dish-row {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #EFECE6;
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-emoji {
  font-size: 42rpx;
  margin-right: 16rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
}

.dish-qty {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B35;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.work-box {
  margin-top: 16rpx;
  background-color: #F7F6F2;
  border-radius: 16rpx;
  padding: 16rpx;
}

.work-img {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.work-note {
  font-size: 26rpx;
  color: #2B2D42;
}

.order-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
  flex-wrap: nowrap;
  gap: 10rpx;
}

.action-btn {
  padding: 12rpx 16rpx;
  font-size: 23rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.btn-share {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  line-height: 1.3;
  margin: 0;
  width: auto !important;
  min-height: 0;
  white-space: nowrap;
  flex-shrink: 0;
}

.share-confirm-btn {
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}

.share-select-all {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
  flex-shrink: 0;
}

.share-check-box {
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.share-check-box.checked {
  background-color: #07C160;
  border-color: #07C160;
}

.shared-meta {
  padding: 14rpx 0 8rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.shared-dish-list {
  max-height: 46vh;
  overflow-y: auto;
}

.upload-box {
  height: 240rpx;
  border-radius: 20rpx;
  background-color: #F7F6F2;
  border: 2rpx dashed #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  text-align: center;
}

.preview-work-img {
  width: 100%;
  height: 100%;
}

.deduct-row {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #374151;
}
