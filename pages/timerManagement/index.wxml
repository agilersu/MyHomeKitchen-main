<view class="container">
  <!-- 快捷预设 -->
  <view class="card">
    <view class="section-title">⚡ 常用做菜预设（点击立即添加）</view>
    <view class="preset-grid">
      <view
        wx:for="{{presets}}"
        wx:key="name"
        class="preset-chip"
        data-name="{{item.name}}"
        data-sec="{{item.sec}}"
        bindtap="onAddPreset"
      >
        <text class="preset-name">{{item.name}}</text>
        <text class="text-muted">{{item.label}}</text>
      </view>
    </view>

    <view class="custom-box row-between">
      <input class="form-input" style="flex: 2;" placeholder="自定义名称（如：炖排骨）" value="{{customName}}" bindinput="onNameInput" />
      <input class="form-input" style="flex: 1;" type="number" placeholder="分钟" value="{{customMinutes}}" bindinput="onMinInput" />
      <view class="add-timer-btn" bindtap="onAddCustom">+ 添加</view>
    </view>
  </view>

  <!-- 计时器列表 -->
  <view class="section-title">⏱ 并发计时队列 ({{timers.length}})</view>

  <view wx:if="{{timers.length === 0}}" class="empty-box">
    <text class="empty-emoji">⏲️</text>
    <view class="empty-title">暂无计时器</view>
    <view class="empty-desc">点击上方预设，或在菜谱详情页步骤中一键定时</view>
  </view>

  <view wx:for="{{timers}}" wx:key="id" class="card timer-card {{item.status === 'running' ? 'running' : ''}}">
    <view class="row-between">
      <view class="flex-1">
        <view class="timer-name">{{item.name}}</view>
        <view class="text-muted">总时长 {{item.durationLabel}}</view>
      </view>
      <text class="badge {{item.status === 'running' ? 'badge-primary' : (item.status === 'finished' ? 'badge-danger' : 'badge-gray')}}">{{item.statusText}}</text>
    </view>

    <view class="clock-text">{{item.clockText}}</view>

    <view class="row-between" style="gap: 14rpx;">
      <view
        class="btn-primary flex-1"
        style="background: {{item.status === 'running' ? '#F59E0B' : ''}};"
        data-id="{{item.id}}"
        bindtap="onToggle"
      >
        {{item.status === 'running' ? '暂停' : '开始'}}
      </view>
      <view class="btn-ghost" data-id="{{item.id}}" bindtap="onReset">重置</view>
      <view class="btn-ghost" style="color: #E5484D;" data-id="{{item.id}}" bindtap="onDelete">删除</view>
    </view>
  </view>
</view>
