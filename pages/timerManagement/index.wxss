.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.preset-chip {
  width: 48%;
  background-color: #F7F6F2;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preset-name {
  font-size: 26rpx;
  font-weight: 700;
}

.custom-box {
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #EFECE6;
}

.custom-box .form-input {
  width: auto;
  min-width: 0;
}

.add-timer-btn {
  background-color: #2B2D42;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  padding: 20rpx 26rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.timer-card {
  border: 2rpx solid transparent;
}

.timer-card .badge {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.timer-card.running {
  border-color: #FF6B35;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F5 100%);
}

.timer-name {
  font-size: 32rpx;
  font-weight: 700;
}

.clock-text {
  font-size: 72rpx;
  font-weight: 800;
  text-align: center;
  letter-spacing: 4rpx;
  margin: 22rpx 0;
  font-variant-numeric: tabular-nums;
}
